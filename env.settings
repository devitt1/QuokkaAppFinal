# This is the public environment variable file.
# No secrets or passwords should go here

# App name should match name in pubspec.yaml file
APP_NAME=quokka_app
APP_BUNDLEID=com.quokkacomputing.app

# DC: Note, this app was originally for Android only, now supports iOS

# iOS Team ID (used in CI/CD and documented here for reference)
IOS_TEAM_ID=79TAL73AZZ

# CSR fields below are ONLY needed for scripted certificate generation via ./appsign ios_key_request
# Update these when setting up CI/CD certificate provisioning
# Make IOS_CSR_TEAM_NAME all lower case and replace spaces with dash and alphanumeric only.
IOS_CSR_TEAM_NAME=quokka-computing-pty-ltd
IOS_CSR_EMAIL=dev@quokkacomputing.com
IOS_CSR_COUNTRY_CODE=AU
IOS_KEYCHAIN_NAME=ios_quokka_keychain
IOS_TMP_FOLDER=_ios_secrets

ANDROID_KEY_FILE=android-key.jks
ANDROID_KEY_INFO="CN=Quokka Computing App, OU=IT, O=Eigen Systems, L=Sydney, S=New South Wales, C=AU"

GOOGLE_UPLOAD_FOLDER=quokka_app